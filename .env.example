APP_NAME=Postduif
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# self-hosted of hosted. Alleen "hosted" serveert de publieke marketingsite op /
# — je eigen installatie hoort geen landingspagina te publiceren die jouw chat
# aanprijst. Alles wat hier niet herkend wordt geldt als self-hosted.
PLATFORM_EDITION=self-hosted

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where message attachments are stored. Private on purpose: they are served
# through a route that checks whether you may see the channel.
MEDIA_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# A prefix for Reverb's own routes, empty when it has a port to itself. Behind a
# proxy that serves Reverb on the application's own domain it needs one, because
# `/app/{key}` — where Reverb serves the websocket — is where this application
# already keeps everything behind the login.
REVERB_SERVER_PATH=
# Serving the app over https requires Reverb to use TLS as well; point these at
# your Valet certificate (~/.config/valet/Certificates/<site>.test.crt/.key).
REVERB_TLS_CERT=
REVERB_TLS_KEY=

# The application token from pushover.net, used to push channel activity to a
# member's own phone. Leave empty to switch pushes off for the whole install;
# members set their own device key in their notification settings.
PUSHOVER_TOKEN=

# Huddles: waar een browser naartoe kijkt om de ander te bereiken. Komma's
# scheiden meerdere. Zonder STUN blijft een huddle binnen hetzelfde netwerk, en
# is de feature ook niet aan te zetten. TURN relayt het geluid en is nodig
# achter symmetrisch NAT; HUDDLE_TURN_SECRET is het gedeelde geheim van coturn,
# waarmee de applicatie inloggegevens tekent die vanzelf verlopen.
HUDDLE_STUN_URLS=
HUDDLE_TURN_URLS=
HUDDLE_TURN_SECRET=

# Webpush: het sleutelpaar waarmee deze installatie zich bij de pushdienst van
# de browser legitimeert. Genereer het met `php artisan webpush:vapid` en laat
# de private sleutel hier nooit weg lekken. VAPID_SUBJECT is verplicht volgens
# RFC 8292 en moet een mailto:-adres of https:-URL zijn waarop de beheerder
# bereikbaar is. Leeg laten zet webpush voor de hele installatie uit.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

VITE_APP_NAME="${APP_NAME}"
# De browser heeft de publieke sleutel nodig om zich te kunnen abonneren.
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_PATH="${REVERB_SERVER_PATH}"

# Whether anybody may sign themselves up. Off leaves invitations as the only
# way in; those create their own accounts and keep working either way.
REGISTRATION_OPEN=true

# What the HTTP step in a workflow may do. Reaching addresses inside this
# server's own network stays off anywhere real — see config/workflows.php.
WORKFLOW_HTTP_TIMEOUT=10
WORKFLOW_HTTP_ALLOW_PRIVATE=false

# The keys Passport signs OAuth tokens with. Left empty here: `php artisan
# passport:keys` writes them to storage/, which is gitignored. Set them in the
# environment instead when storage/ is not persistent — a fresh pair logs out
# every connected AI client.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Waar Ghostscript staat. Elke geuploade contract-PDF wordt hierdoor
# herschreven: dat is wat ingebedde JavaScript en bijlagen eruit haalt en
# het bestand naar PDF 1.4 schrijft, de versie die de overlay kan lezen.
# Zonder dit weigert de upload elk bestand.
#
# Een pad en niet 'gs', want het PATH van php-fpm is niet dat van je shell.
GHOSTSCRIPT_PATH=

# Waar opgenomen huddles uitgeschreven worden: een OpenAI-compatibel
# /audio/transcriptions-endpoint. Leeg laten betekent dat er niet
# getranscribeerd wordt — opnames zeggen dan zelf waarom. Wijs dit naar
# localhost voor een eigen whisper-server, of naar api.openai.com/v1.
TRANSCRIPTION_URL=
TRANSCRIPTION_TOKEN=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT=600
